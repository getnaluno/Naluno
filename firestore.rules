rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ---- Quality metrics (sampled client writes) ----
    match /metrics/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['name','uid']);
      allow read, update, delete: if false;
    }

    // ---- Identity ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /handles/{handle} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /users/{uid}/signal/{segId} {
      allow read: if isOwner(uid)
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(uid)/connections/$(request.auth.uid)));
      allow create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/compassMessages/{msgId} {
      allow read, create, delete: if isOwner(uid);
    }

    match /users/{uid}/connections/{otherUid} {
      allow read: if isOwner(uid);
      allow write: if isSignedIn() && (isOwner(uid) || otherUid == request.auth.uid);
    }

    // ---- Wireline (1:1 threads) ----
    match /threads/{threadId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.from == request.auth.uid
          && (
            !('type' in request.resource.data)
            || request.resource.data.type != 'missed_call'
            || request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants
          );
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        allow delete: if isSignedIn() && (
          resource.data.from == request.auth.uid
          || resource.data.type == 'missed_call'
        );
      }
    }

    // ---- Real calls ----
    match /calls/{callId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.callerUid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);

      match /callerCandidates/{candId} {
        allow read, create: if isSignedIn();
      }
      match /calleeCandidates/{candId} {
        allow read, create: if isSignedIn();
      }
    }

    // ---- Band (market square — no owner, no delete) ----
    // A Band is a place, not a group chat. Anyone who is a member can read and
    // update membership (join/leave). Nobody — including the person who opened
    // it — can delete the square itself.
    function isBandMember(bandId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/bands/$(bandId)).data.memberUids;
    }
    match /bands/{bandId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      // Membership edits, lastEmptiedAt, bell — never delete the square.
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid in request.resource.data.memberUids);
      allow delete: if false;

      match /presence/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        // Cleanup of expired square chatter (client may prune after settle window)
        allow delete: if isSignedIn();
      }
      match /invites/{inviteId} {
        allow read: if isSignedIn()
          && (request.auth.uid == resource.data.toUid
              || request.auth.uid == resource.data.fromUid
              || isBandMember(bandId));
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && isBandMember(bandId);
        allow update: if isSignedIn()
          && (request.auth.uid == resource.data.toUid
              || request.auth.uid == resource.data.fromUid);
      }
      // Legacy signal collection
      match /rtc/{signalId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
      }
      // Pair-doc mesh signaling (offer/answer + ice)
      match /mesh/{pairId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        match /ice/{iceId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        }
      }
    }

    // Personal inbox (square invites, etc.)
    match /users/{uid}/notifications/{notifId} {
      allow read, update: if isOwner(uid);
      allow create: if isSignedIn();
    }
  
    // ---- Broadcast spaces (living communities) ----
    match /broadcasts/{bcastId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      // Creator can full-update; any signed-in user may only arrayUnion themselves into memberUids (Join community)
      allow update: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid
        || (
          request.auth.uid in request.resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
        )
      );
      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;

      match /conversation/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
      match /questions/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        allow update: if isSignedIn();
        allow delete: if false;
      }
      match /results/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
      match /resources/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
      match /journey/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
      match /updates/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
      match /liveSessions/{viewerUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isSignedIn();
        match /viewerIce/{iceId} {
          allow read, create: if isSignedIn();
        }
        match /hostIce/{iceId} {
          allow read, create: if isSignedIn();
        }
      }
      match /liveReactions/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow delete: if false;
      }
    }
  }
}
