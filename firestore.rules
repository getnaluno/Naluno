rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ---- Identity ----
    match /users/{uid} {
      allow read: if isSignedIn();          // anyone signed in can look someone up
      allow write: if isOwner(uid);         // only you can edit your own Callsign
    }

    // handles/{handle} maps a claimed handle -> uid. Enforces uniqueness: Firestore
    // rejects a second create() at the same document path, so two people racing to
    // claim "@nova" can't both succeed.
    match /handles/{handle} {
      allow read: if true; // handle lookup needs to work before sign-in resolves
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Only the current owner can re-write their own handle doc (e.g. a redundant
      // re-save) — this must NEVER let someone else's uid overwrite an existing claim.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false; // not transferable in Phase 1 — revisit later
    }

    // ---- Broadcast (your signal) ----
    // A segment at users/{uid}/signal/{segId} is one posted photo/video/text. Only the
    // owner can post or remove their own; a real connection of theirs can read it —
    // this is what makes Frequencies and Broadcast the same set of real people instead
    // of two disconnected screens. This whole subcollection was missing from the rules
    // entirely, which is why every post silently failed permission checks.
    match /users/{uid}/signal/{segId} {
      allow read: if isOwner(uid)
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(uid)/connections/$(request.auth.uid)));
      allow create, delete: if isOwner(uid);
    }

    // Compass conversations are entirely private — no connection-visibility rule
    // like signal has, since this isn't something meant to ever be shared.
    match /users/{uid}/compassMessages/{msgId} {
      allow read, create, delete: if isOwner(uid);
    }

    // ---- Real connections (replacing hardcoded demo contacts) ----
    // A connection doc at users/{uid}/connections/{otherUid} means "otherUid appears in
    // uid's Frequencies list." Connecting is mutual and instant in Phase 1 (no request/
    // accept flow yet) — writing the *other* person's mirror entry is only allowed when
    // that entry's id is literally you, so you can only ever add yourself to someone
    // else's list, never edit anything else about their account.
    match /users/{uid}/connections/{otherUid} {
      allow read: if isOwner(uid);
      allow write: if isSignedIn() && (isOwner(uid) || otherUid == request.auth.uid);
    }

    // ---- Wireline (1:1 threads) ----
    // threadId convention: the two participant uids sorted and joined with "_".
    match /threads/{threadId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        // updates cover receipts (status) and reactions — both legitimately come from
        // the *other* participant, not just the author, so this stays permissive for now.
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        // Only the original sender can delete their own message — this was missing
        // entirely, which is why the delete button did nothing but fail silently.
        allow delete: if isSignedIn() && resource.data.from == request.auth.uid;
      }
    }

    // ---- Real calls (WebRTC signaling via Firestore) ----
    // Each call is its own document — unlike threads, calls aren't a persistent channel;
    // every attempt is a fresh doc. Candidate subcollections stay permissive (any signed-in
    // user) rather than doing an extra get() lookup per ICE candidate write; the callId
    // itself is an unguessable random doc ID, the same trust level the rest of this app
    // currently runs on.
    match /calls/{callId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.callerUid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);

      match /callerCandidates/{candId} {
        allow read, create: if isSignedIn();
      }
      match /calleeCandidates/{candId} {
        allow read, create: if isSignedIn();
      }
    }

    // ---- Band (live shared frequency) ----
    match /bands/{bandId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn(); // membership edits — tighten once "leave" ships server-side

      match /presence/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid); // you can only mark *yourself* as tuned in
      }
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        // Sender can hard-delete their own line. After the square empties,
        // any signed-in member (or anyone, if lastEmptiedAt is set) can prune
        // the settled chatter so the 2h wipe actually lands in Firestore.
        allow delete: if isSignedIn() && (
          resource.data.from == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/bands/$(bandId)).data.memberUids
          || get(/databases/$(database)/documents/bands/$(bandId)).data.lastEmptiedAt != null
        );
      }
      match /invites/{inviteId} {
        allow read, write: if isSignedIn();
      }
      match /mesh/{pairId} {
        allow read, write: if isSignedIn();
        match /{iceCol}/{iceId} {
          allow read, write: if isSignedIn();
        }
      }
    }

    match /sparks/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /sparkRooms/{roomId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
      }
    }

    match /users/{uid}/notifications/{nid} {
      allow read: if isOwner(uid);
      allow create: if isSignedIn();
      allow update, delete: if isOwner(uid);
    }

    match /users/{uid}/beacons/{id} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/wirelineClears/{id} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/wirelineHidden/{id} {
      allow read, write: if isOwner(uid);
    }

    match /broadcasts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isSignedIn();
      match /{col}/{docId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    match /strands/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
    }

    match /originMarks/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /toga/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /users/{uid}/circle/{memberUid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isOwner(uid) || memberUid == request.auth.uid);
    }
  }
}
