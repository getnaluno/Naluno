 "sentences": [
  {
   "text": "Weebale nnyo, ssebo!",
   "phones": "weːbale ɲːo, sːebo!",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Oli otya, mukwano gwange?",
   "phones": "oli otja, mukwaːno ɡwaːŋɡe?",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Tusanyuse okukulaba.",
   "phones": "tusaɲuse okukulaba.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Katonda akuwe emirembe.",
   "phones": "katoːnda akuwe emiɾeːmbe.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Kampala kibuga kinene mu Uganda.",
   "phones": "kaːmpala tʃibuɡa tʃinene mu uɡaːnda.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Leero lwa Bbalaza.",
   "phones": "leːɾo lwa bːalaza.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Abantu bangi baagenda mu kibuga okulaba omupiira.",
   "phones": "abaːntu baːɲdʒi baːɡeːnda mu tʃibuɡa okulaba omupiːɾa.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Ebigambo bino bya Luganda.",
   "phones": "ebiɡaːmbo bino bja luɡaːnda.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Eno y'entandikwa.",
   "phones": "eno jeːntaːndikwa.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Mwebale nnyo abantu bonna.",
   "phones": "mweːbale ɲːo abaːntu bonːa.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Webale okuwandiika ku Naluno.",
   "phones": "webale okuwaːndiːka ku naluno.",
   "lang": "lg",
   "check": true
  },
  {
   "text": "Nnina abaana 3 n'emmere ennyingi.",
   "phones": "nːina abaːna sːatu nemːeɾe eɲːiːɲdʒi.",
   "lang": "lg",
   "check": true
  }
 ],
