{
  "name": "Naluno",
  "short_name": "Naluno",
  "description": "A quieter way to reach people. No phone number.",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0D0F17",
  "theme_color": "#0D0F17",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/app/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "lifeline_title",
      "text": "lifeline_text",
      "url": "lifeline_url"
    }
  }
}